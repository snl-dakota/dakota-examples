\{
  "simulation" :
  \{
    "verbose"    :  true,
    "time_steps" :  300,
    "dt"         :  { 0.2*plasma_period*mult },
    "xmin"       :  0.0,
    "xmax"       :  { dx*n_cell },
    "num_elems"  :  { n_cell }
  \},

  "output" :
  \{
    "show_plots" :  false,
    "densities"  :  true
  \},

  "particle_types" :
  \{
    "ion" :
    \{
      "charge" :  { q_e },
      "mass"   :  1.0e20,
      "weight" :  { n_ppc*weight }
    \},
    "e-" :
    \{
      "charge" : -{ q_e },
      "mass"   :  { m_e },
      "weight" :  { weight }
    \}
  \},

  "initial_conditions" :
  \{
    "ion" :
    \{
      "num"  :  { n_cell+1 },
      "vx0"  :  0.0,
      "T"    :  0.0
    \},
    "e-" :
    \{
      "num"  :  { n_cell*n_ppc+1 },
      "vx0"  :  0.0,
      "T"    :  { Te },
      "perturb_x" : "0.0+0.0001*sin(0.4082479456*x+0.1020619864)"
    \}
  \}
\}
